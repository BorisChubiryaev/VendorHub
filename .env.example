# Сервер
PORT=3000
JWT_SECRET=замените-на-длинную-случайную-строку
JWT_TTL=12h
DB_PATH=./data/vendorhub.db
UPLOAD_DIR=./data/uploads
# Загружать демо-данные в пустую БД
SEED_DEMO_DATA=true
HOURS_PER_MONTH=160
# Лимит размера загрузки резюме, МБ (на Vercel по умолчанию 4)
MAX_UPLOAD_MB=15

# Бэклог: mock (встроенный) | jira (Jira / СберТрек REST API v2)
BACKLOG_PROVIDER=mock
JIRA_URL=
JIRA_TOKEN=
JIRA_PROJECT=
JIRA_ISSUE_TYPE=Story

# Языковая модель (OpenAI-совместимый chat/completions, например шлюз к GigaChat).
# Пусто — ассистент и распознавание резюме работают на правилах.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=GigaChat

# СберЧат: токен бота для входящего webhook и URL для отправки ответов
SBERCHAT_BOT_TOKEN=
SBERCHAT_OUTBOUND_URL=

# Callback'и внешних систем по шагам маршрута (Пульс, ЛК, модуль лимитов)
INTEGRATION_TOKEN=
